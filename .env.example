# Copy this file to .env and fill in your key.
# Free Groq key: https://console.groq.com  ->  API Keys  ->  Create API Key
# Leave LLM_API_KEY empty to run in demo mode (rule-based, no AI).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Embeddings run locally inside the API container (no key needed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
